# FRIDAY Environment Variables Example
# Copy to ~/.friday/.env

# General
FRIDAY_LOG_LEVEL=INFO
FRIDAY_USER_NAME=Raj

# LLM Configuration
FRIDAY_LLM_ENGINE=ollama
FRIDAY_LLM_PROVIDER=ollama
FRIDAY_LLM_PRIMARY_MODEL=qwen2.5-coder:7b
FRIDAY_LLM_FALLBACK_MODEL=tinyllama
FRIDAY_LLM_BASE_URL=http://localhost:11434
FRIDAY_LLM_API_KEY=
FRIDAY_LLM_API_BASE_URL=https://api.openai.com/v1

# Memory Configuration
FRIDAY_MEMORY_ENABLED=true
FRIDAY_MEMORY_RETRIEVAL_LIMIT=3

